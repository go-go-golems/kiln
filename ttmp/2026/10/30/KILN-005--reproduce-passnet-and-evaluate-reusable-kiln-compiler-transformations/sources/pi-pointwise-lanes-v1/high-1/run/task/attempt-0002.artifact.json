{
  "format": "kiln-optimization-artifact/1",
  "input_ir": "kiln-tensor/1",
  "action_contract": "kiln-pointwise-staged-fusion/1",
  "feature_contract": "kiln-loop-fusion-features/1",
  "numerical_policy": {
    "contraction": "separate"
  },
  "applicability": {
    "pipeline": "emmy",
    "static_shapes": true
  },
  "program_budget": {
    "max_nodes": 31,
    "max_depth": 6,
    "max_work_growth": 2
  },
  "program": {
    "cleanup": {
      "consumer_tree": {
        "threshold": 1.02
      },
      "format": "kiln-fusion-policy/1",
      "id": "cleanup",
      "kind": "selective",
      "tree": {
        "else": {
          "threshold": 1.02
        },
        "if": {
          "feature": "originalWork",
          "op": "lt",
          "value": 500000
        },
        "then": {
          "threshold": 0.95
        }
      }
    },
    "expose": {
      "consumer_tree": {
        "else": {
          "threshold": 1.5
        },
        "if": {
          "feature": "producerElements",
          "op": "le",
          "value": 20000
        },
        "then": {
          "threshold": 1.05
        }
      },
      "format": "kiln-fusion-policy/1",
      "id": "expose",
      "kind": "selective",
      "tree": {
        "else": {
          "threshold": 1.02
        },
        "if": {
          "feature": "producerElements",
          "op": "le",
          "value": 20000
        },
        "then": {
          "threshold": 1
        }
      }
    },
    "format": "kiln-transformation-program/1",
    "id": "artifact-policy",
    "kind": "pointwise-fusion-sequence"
  }
}
