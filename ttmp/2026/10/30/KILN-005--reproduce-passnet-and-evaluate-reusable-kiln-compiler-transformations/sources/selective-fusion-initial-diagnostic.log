n1 = 1  -> f32

n11 = loop.kernel ·(n1)  -> (32) f32
    in0 = load n1[]
    for a0 in 0..32:  # free
        out[a0] = in0

n12 = loop.kernel ·(n10, n11)  -> (32) f32
    for a0 in 0..32:  # free
        in0 = load n10[a0]
        in1 = load n11[a0]
        v0 = add(in0, in1)
        out[a0] = v0

n3 = 2  -> f32

n13 = loop.kernel ·(n3)  -> (32) f32
    in0 = load n3[]
    for a0 in 0..32:  # free
        out[a0] = in0

n14 = loop.kernel ·(n10, n13)  -> (32) f32
    for a0 in 0..32:  # free
        in0 = load n10[a0]
        in1 = load n13[a0]
        v0 = mul(in0, in1)
        out[a0] = v0

outputs:
