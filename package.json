{
  "name": "kiln",
  "private": true,
  "type": "module",
  "description": "Kiln × Perf Lab: a compiler workbench whose decisions rest on measured, provenance-tagged evidence.",
  "packageManager": "pnpm@12.4.1",
  "engines": { "node": ">=26" },
  "scripts": {
    "build": "pnpm --filter @kiln/workbench build",
    "dev": "pnpm --filter @kiln/workbench build && pnpm --filter @kiln/server start",
    "serve": "pnpm --filter @kiln/server start",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "shoot": "node scripts/shoot.mjs"
  }
}
